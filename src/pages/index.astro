---
import Avatar from '~/components/Avatar.astro'
import { LinkButton } from '~/components/buttons/Button'
import { Clock } from '~/components/Clock'
import Contacts from '~/components/Contacts.astro'
import { GradientText } from '~/components/GradientText'
import LineOfWork from '~/components/LineOfWork.astro'
import Page from '~/components/layouts/Page.astro'
import Section from '~/components/layouts/Section.astro'
import ExperienceReVanced from '~/components/pages/work/ExperienceReVanced.astro'
import ExperienceRevenge from '~/components/pages/work/ExperienceRevenge.astro'
import SkillItem from '~/components/SkillItem.astro'
import SkillsGrid from '~/components/SkillsGrid.astro'
import { SwappingText } from '~/components/SwappingText'
import { SKILLS as SKILLS_ } from '~/data/skills'
import IconMail from '~/icons/mail.svg?component-solid'
import IconNext from '~/icons/next.svg?component-solid'
import IconWork from '~/icons/work.svg?component-solid'
import Glow from '~/images/glow.svg'
import { getAge } from '~/utils/date'
import type { Skill } from '~/data/skills'

const SKILLS = SKILLS_ as Record<string, Skill>
---

<Page>
	<section id="hero" flex="y-center" gap="3xl">
		<div class="hero-intro" flex="vert">
			<Avatar />
			<div class="hero-content" flex="vert" gap="l">
				<div flex="vert" gap="m">
					<h1 class="text-display">I'm <span><GradientText direction='45deg'>Palm</GradientText></span>!</h1>
					<div class="text-label-large">
						<p class="tint-high">Software Developer, UI/UX Designer</p>
						<p class="tint-low">Bangkok, Thailand<span aria-hidden="true"> • <Clock client:idle /></span></p>
					</div>
					<p class="text-body-large balance">I make cool things with user experience and accessibility in mind.</p>
				</div>
				<div class="hero-buttons" flex="wrap" gap="m">
					<LinkButton client:visible href="#get-in-touch" icon={IconMail} text="Talk with me" />
					<LinkButton client:visible href="/work" variant="glass" icon={IconWork} text="View my work" />
				</div>
			</div>
		</div>
		<div class="hero-side" flex="vert" gap="xl">
			<LineOfWork stacked />
			<div flex="vert" gap="m">
				<h1 class="text-heading">with these technologies</h1>
				<div flex="vert" gap="xs">
					<ul class="list skills-list">
						{Object.values(SKILLS).slice(0, 6).map(({ name, icon, iconLight }) => (
							<li>
								<SkillItem {name} {icon} {iconLight} />
							</li>
						))}
					</ul>
					<div flex="vert" style="align-items: flex-start;">
					<LinkButton client:visible href="#skills" variant="glass" text="and much more" trailingIcon={IconNext} />
					</div>
				</div>
			</div>
		</div>
	</section>
	<section id="brief" flex="vert center">
		<div class="glow">
			<img class="unselectable" src={Glow.src} width={Glow.width} height={Glow.height} alt="" draggable="false" />
		</div>
		<div class="brief-text text-title" flex="vert" gap="2xl">
			<p class="balance">I've been making websites<br>and apps for <span class="tint-high">more than {getAge() - 13} years</span>.</p>
			<p class="balance neutral-medium">My mission is to tackle <span class="tint-medium">real issues</span><br>with <span class="tint-high">real solutions</span>, <span class="tint-high">elegantly</span>.</p>
		</div>
	</section>
	<Section id="experience">
		<Fragment slot="title">
			<span class="sr-only">I've worked on</span>
			<span aria-hidden="true">I've <span class="tint-high"><SwappingText client:visible words={['worked', 'collaborated', 'made craft', 'pondered']} /></span> on</span>
		</Fragment>
		<div flex="vert" gap="m">
			<ExperienceReVanced />
			<ExperienceRevenge />
		</div>
		<div id="skills" flex="vert" gap="l">
			<h2 class="text-heading">and with these technologies</h2>
			<SkillsGrid />
		</div>
	</Section>
	<Section id="get-in-touch" pady="4xl">
		<Fragment slot="title">Let's <span class="tint-high">talk</span></Fragment>
		<p slot="description" class="text-label-large">
			— whether it'll be about <span class="tint-medium">work</span>, or just a <span class="tint-medium">casual chat</span> — I don't mind!
			<br>
			You can reach me via these channels.
		</p>
		<Contacts />
	</Section>
</Page>

<style lang="scss">
	@use '../styles/breakpoints';

	.balance {
		text-wrap: balance;
		text-wrap: pretty;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	section {
		width: 100%;
		max-width: 720px;
	}

	section#hero {
		padding-block: min(var(--gap-4xl), 10vh);
		min-height: min(85dvh, 972px);
		align-items: center;
	}

	@media (min-width: breakpoints.$tablet) {		
		#skills {
			max-width: 720px;
			align-self: center;
		}
	}

	section#hero {
		max-width: 1144px;
	}

	section#experience {
		max-width: 1080px;
	}

	.hero-intro,
	.hero-side {
		flex: 1;
		min-width: 0;
	}

	.hero-content {
		padding-block-start: var(--gap-2xl);
	}

	.skills-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--gap-xs);
		width: fit-content;
		max-width: 100%;

		border-radius: var(--gap-m);
		backdrop-filter: blur(8px);
	}

	section#brief {
		position: relative;
		padding-block: 96px;
		padding-block-end: 128px;
		text-align: center;
	}

	$glow-max-scale: 1.1;
	$glow-breathe-duration: 6s;

	.glow {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		display: flex;
		justify-content: center;
		// Let the glow be wider than the screen
		width: calc(100cqw + var(--page-padding) * 2);
		// Fade out over 128px on each side
		height: calc(100% + 256px);
		z-index: var(--layer-effect);
		pointer-events: none;
		animation: glow-in $glow-breathe-duration * 0.5 ease-out;

		@media (pointer: fine) {
			$fade: var(--gap-4xl);

			// eased fade out
			mask-image: linear-gradient(
				to right,
				transparent,
				rgb(0 0 0 / 0.16) calc($fade * 0.25),
				rgb(0 0 0 / 0.5) calc($fade * 0.5),
				rgb(0 0 0 / 0.84) calc($fade * 0.75),
				black $fade,
				black calc(100% - $fade),
				rgb(0 0 0 / 0.84) calc(100% - $fade * 0.75),
				rgb(0 0 0 / 0.5) calc(100% - $fade * 0.5),
				rgb(0 0 0 / 0.16) calc(100% - $fade * 0.25),
				transparent
			);
		}

		& img {
			flex-shrink: 0;
			width: 976px;
			height: 100%;
			// Starts halfway, so it's fully breathed in right as the glow finishes fading in.
			// Don't split this into a separate intro animation, the handoff between them flashes
			animation: breathe $glow-breathe-duration ease-in-out $glow-breathe-duration * -0.5 infinite alternate;
		}
	}

	.brief-text {
		position: relative;
		z-index: var(--layer-content);
		text-wrap: balance;

		& span {
			white-space: nowrap;
		}
	}

	.more-text {
		flex: 1;
	}

	@media (max-width: breakpoints.$tablet + 192px) {
		section#hero {
			flex-direction: column;
			align-items: center;
			gap: var(--gap-xl);
			padding-block: var(--gap-2xl);
		}

		.hero-intro,
		.hero-side {
			flex: initial;
			width: 100%;
			max-width: 720px;
		}

		.hero-intro {
			align-items: center;
			text-align: center;
		}

		.hero-content {
			padding-block-start: var(--gap-xl);
		}

		.hero-intro :is(h1, p) {
			text-wrap: balance;
		}

		.hero-buttons {
			justify-content: center;
		}

		section#more {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@keyframes glow-in {
		from {
			opacity: 0;
		}
	}

	@keyframes breathe {
		from {
			scale: 0.9;
			opacity: 0.75;
		}

		to {
			scale: $glow-max-scale;
			opacity: 1;
		}
	}

	.tint-high {
		color: var(--tinted-high);
	}

	.tint-medium {
		color: var(--tinted-medium);
	}

	.tint-low {
		color: var(--tinted-low);
	}

	.neutral-medium {
		color: var(--neutral-medium);
	}
</style>
