---
import './SkillItem.scss'

import Card from './Card.astro'
import LightDarkImage from './LightDarkImage.astro'
import Touchable from './Touchable'

interface Props {
	name: string
	icon: ImageMetadata
	iconLight?: ImageMetadata
	noBlur?: boolean
	variant?: 'xsmall' | 'xsmall-horz' | 'small' | 'large' | 'large-horz' | 'large-vert'
}

const { name, icon, iconLight, variant = 'small', noBlur = false } = Astro.props
const isLarge = ['large', 'large-horz', 'large-vert'].includes(variant)
const isHorz = ['large-horz', 'xsmall-horz'].includes(variant)
const imgSizeClass =
	variant.startsWith('xsmall') ? 'xsmall' : variant === 'large' ? 'large' : false
---

<Touchable class="item" client:visible aria-label={name} title={name}>
    <Card class:list={["item", "pad", noBlur ? 'no-blur' : undefined]} data-variant={variant} flex={isHorz ? 'center' : 'vert center'} gap="xs" no-blur>
        <div class="icon-cont">
            <LightDarkImage draggable="false" aria-hidden="true" srcLight={iconLight} src={icon} alt={name} class:list={["icon", imgSizeClass]} />
            <LightDarkImage draggable="false" aria-hidden="true" srcLight={iconLight} src={icon} alt={name} class:list={["icon", "icon-glow", imgSizeClass]} />
        </div>
        <span aria-hidden="true" class:list={[isLarge ? 'text-label-medium' : 'text-label-small', 'text']}>{name}</span>
    </Card>
</Touchable>

<style lang="scss">
    @use "../styles/breakpoints";

    .item {
        width: 100%;
        height: 100%;
        border-radius: var(--rad-sm);
        cursor: default;
    
        &:active {
            transform: none;
        }
    }

    .no-blur {
        backdrop-filter: none;
    }
    
    .pad {
        padding: var(--gap-s);

        @media (max-width: breakpoints.$phone) {
            padding: var(--gap-xs);
        }
    }

    .text {
        text-align: center;

        &.text-label-small {
            color: var(--neutral-low);
        }
    }

    .icon-cont {
        display: flex;
        position: relative;
    }

    // Not enough room beside the icon, stack the label below instead
    @media (max-width: breakpoints.$tablet) {
        .item[data-variant="large-horz"] {
            flex-direction: column;
        }

        .text.text-label-medium {
            font-size: var(--text-size-label-small);
        }
    }
</style>
    